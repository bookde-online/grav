<section id="about" class="about-section" style="padding: 60px 0; background-color: #f9f9f9;">
	<div class="container" style="max-width: 1200px; margin: 0 auto;">
		<div class="row" style="display: flex; align-items: center; flex-wrap: wrap;">

			<div class="col-lg-6" style="flex: 1 1 50%; padding: 20px; text-align: center;">
				<img src="{{ page.media.images|first.url }}" alt="BookDe" class="img-fluid rounded" loading="lazy">
			</div>

			<div class="col-lg-6" style="flex: 1 1 50%; padding: 20px;">
				<h2 style="color: #A93226; font-size: 2.5em; margin-bottom: 20px;">{{ page.header.title }}</h2>
				<p style="font-size: 1.1em; line-height: 1.6; color: #555;">{{ page.content|raw }}</p>
				<a href="{{ base_url }}/{{ grav.language.getLanguage == 'en' ? 'contact' : 'lien-he' }}">
					{{ grav.language.getLanguage == 'en' ? 'Get in touch' : 'Liên hệ' }}
				</a>

			</div>

		</div>
	</div>
</section>
