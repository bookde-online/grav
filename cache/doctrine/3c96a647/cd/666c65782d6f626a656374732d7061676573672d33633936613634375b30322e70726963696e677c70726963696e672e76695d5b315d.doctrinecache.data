O:39:"Grav\Common\Flex\Types\Pages\PageObject":4:{s:4:"type";s:5:"pages";s:3:"key";s:7:"pricing";s:8:"elements";a:4:{s:4:"root";b:0;s:6:"header";a:6:{s:5:"title";s:9:"Giá cả";s:8:"metadata";a:2:{s:11:"description";s:243:"Nâng cao hiệu quả đặt phòng và sự hài lòng của khách hàng với các giải pháp trực tuyến tùy chỉnh. Đơn giản hóa việc đặt phòng và tăng số lượng đặt phòng trực tiếp một cách dễ dàng.";s:8:"keywords";s:51:"giá cả, giải pháp , ưu đãi , đặt phòng";}s:4:"slug";s:6:"gia-ca";s:7:"content";a:1:{s:5:"items";s:13:"@self.modular";}s:13:"pricing_plans";a:3:{i:0;a:9:{s:4:"name";s:49:"Phát triển trang web khách sạn tùy chỉnh";s:12:"discount_tag";s:3:"60%";s:13:"orginal_price";s:7:"500.000";s:5:"price";s:7:"200.000";s:13:"currency_unit";s:4:"VNĐ";s:13:"duration_unit";s:5:"ngày";s:14:"features_title";s:84:"Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.";s:8:"features";a:1:{i:0;a:1:{s:4:"text";s:723:"Biến đổi sự hiện diện trực tuyến của khách sạn bạn với dịch vụ phát triển trang web tùy chỉnh của chúng tôi. Tạo một trang web phù hợp với thương hiệu của bạn, với toàn quyền kiểm soát đặt phòng và tương tác khách hàng. Nền tảng dễ sử dụng của chúng tôi đảm bảo thiết lập nhanh chóng, kết nối trực tiếp với khách và tăng hiệu quả đặt phòng. Nổi bật trong thị trường cạnh tranh với một trang web cá nhân hóa, thúc đẩy nhiều đặt phòng trực tiếp hơn và tối đa hóa doanh thu. Sở hữu tên miền của bạn và nâng cao thành công của khách sạn ngay hôm nay!";}}s:4:"link";s:35:"./dich-vu/tuy-chinh-trang-khach-san";}i:1;a:9:{s:4:"name";s:51:"Dịch vụ hỗ trợ đặt phòng trực tuyến";s:12:"discount_tag";s:3:"60%";s:13:"orginal_price";s:9:"1.000.000";s:5:"price";s:7:"400.000";s:13:"currency_unit";s:4:"VNĐ";s:13:"duration_unit";s:5:"ngày";s:14:"features_title";s:84:"Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.";s:8:"features";a:1:{i:0;a:1:{s:4:"text";s:665:"Nâng cao quy trình đặt phòng của khách sạn bạn với dịch vụ hỗ trợ toàn diện của chúng tôi. Chúng tôi tối ưu hóa hệ thống đặt phòng của bạn để tăng số lượng đặt phòng trực tiếp và sự hài lòng của khách hàng. Đội ngũ của chúng tôi giúp bạn thiết lập và quản lý các hệ thống đặt phòng hiệu quả, đảm bảo trải nghiệm mượt mà từ duyệt web đến đặt phòng. Giảm sự phụ thuộc vào các nền tảng bên thứ ba, tiết kiệm chi phí hoa hồng và tăng doanh thu của bạn với sự hỗ trợ chuyên nghiệp của chúng tôi.";}}s:4:"link";s:31:"./dich-vu/ho-tro-dat-truc-tuyen";}i:2;a:9:{s:4:"name";s:49:"Phát triển trang web khách sạn tùy chỉnh";s:12:"discount_tag";s:3:"70%";s:13:"orginal_price";s:9:"2.000.000";s:5:"price";s:7:"800.000";s:13:"currency_unit";s:4:"VNĐ";s:13:"duration_unit";s:5:"ngày";s:14:"features_title";s:84:"Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.";s:8:"features";a:1:{i:0;a:1:{s:4:"text";s:550:"Kiểm soát danh tính trực tuyến của khách sạn bạn với dịch vụ sở hữu tên miền của chúng tôi. Mua và quản lý tên miền của riêng bạn để thiết lập sự hiện diện thương hiệu mạnh mẽ. Một tên miền cá nhân hóa tăng cường độ tin cậy, giúp khách dễ dàng tìm và đặt phòng trực tiếp với bạn. Nổi bật so với đối thủ cạnh tranh và xây dựng niềm tin với khách hàng tiềm năng bằng cách bảo mật tên miền của bạn ngay hôm nay!";}}s:4:"link";s:40:"./dich-vu/giai-phap-toi-uu-hoa-dat-phong";}}s:7:"process";a:2:{s:8:"markdown";b:1;s:4:"twig";b:1;}}s:11:"frontmatter";s:3716:"title: 'Giá cả'
metadata:
    description: 'Nâng cao hiệu quả đặt phòng và sự hài lòng của khách hàng với các giải pháp trực tuyến tùy chỉnh. Đơn giản hóa việc đặt phòng và tăng số lượng đặt phòng trực tiếp một cách dễ dàng.'
    keywords: 'giá cả, giải pháp , ưu đãi , đặt phòng'
slug: gia-ca
content:
    items: '@self.modular'
pricing_plans:
    -
        name: 'Phát triển trang web khách sạn tùy chỉnh'
        discount_tag: '60%'
        orginal_price: '500.000'
        price: '200.000'
        currency_unit: VNĐ
        duration_unit: ngày 
        features_title: 'Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.'
        features:
        -   
                text:  'Biến đổi sự hiện diện trực tuyến của khách sạn bạn với dịch vụ phát triển trang web tùy chỉnh của chúng tôi. Tạo một trang web phù hợp với thương hiệu của bạn, với toàn quyền kiểm soát đặt phòng và tương tác khách hàng. Nền tảng dễ sử dụng của chúng tôi đảm bảo thiết lập nhanh chóng, kết nối trực tiếp với khách và tăng hiệu quả đặt phòng. Nổi bật trong thị trường cạnh tranh với một trang web cá nhân hóa, thúc đẩy nhiều đặt phòng trực tiếp hơn và tối đa hóa doanh thu. Sở hữu tên miền của bạn và nâng cao thành công của khách sạn ngay hôm nay!'
        link: ./dich-vu/tuy-chinh-trang-khach-san
    -
        name: 'Dịch vụ hỗ trợ đặt phòng trực tuyến'
        discount_tag: '60%'
        orginal_price: '1.000.000'
        price: '400.000'
        currency_unit: VNĐ
        duration_unit: ngày 
        features_title: 'Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.'
        features:
        -   
                text:  'Nâng cao quy trình đặt phòng của khách sạn bạn với dịch vụ hỗ trợ toàn diện của chúng tôi. Chúng tôi tối ưu hóa hệ thống đặt phòng của bạn để tăng số lượng đặt phòng trực tiếp và sự hài lòng của khách hàng. Đội ngũ của chúng tôi giúp bạn thiết lập và quản lý các hệ thống đặt phòng hiệu quả, đảm bảo trải nghiệm mượt mà từ duyệt web đến đặt phòng. Giảm sự phụ thuộc vào các nền tảng bên thứ ba, tiết kiệm chi phí hoa hồng và tăng doanh thu của bạn với sự hỗ trợ chuyên nghiệp của chúng tôi.'
        link: ./dich-vu/ho-tro-dat-truc-tuyen
    -
        name: 'Phát triển trang web khách sạn tùy chỉnh'
        discount_tag: '70%'
        orginal_price: '2.000.000'
        price: '800.000'
        currency_unit: VNĐ
        duration_unit: ngày 
        features_title: 'Xây dựng sự hiện diện trực tuyến độc đáo của khách sạn bạn.'
        features:
        -   
                text:  'Kiểm soát danh tính trực tuyến của khách sạn bạn với dịch vụ sở hữu tên miền của chúng tôi. Mua và quản lý tên miền của riêng bạn để thiết lập sự hiện diện thương hiệu mạnh mẽ. Một tên miền cá nhân hóa tăng cường độ tin cậy, giúp khách dễ dàng tìm và đặt phòng trực tiếp với bạn. Nổi bật so với đối thủ cạnh tranh và xây dựng niềm tin với khách hàng tiềm năng bằng cách bảo mật tên miền của bạn ngay hôm nay!'
        link: ./dich-vu/giai-phap-toi-uu-hoa-dat-phong
  
process:
    markdown: true
    twig: true";s:8:"markdown";s:0:"";}s:7:"storage";a:8:{s:3:"key";s:7:"pricing";s:11:"storage_key";s:21:"02.pricing|pricing.vi";s:8:"template";s:7:"pricing";s:17:"storage_timestamp";i:1748267434;s:8:"markdown";a:2:{s:2:"en";a:1:{s:7:"pricing";i:1748267434;}s:2:"vi";a:1:{s:7:"pricing";i:1747913180;}}s:8:"checksum";s:32:"e7b43df7bbdafbb99e455c2e3983e87a";s:6:"exists";b:1;s:4:"lang";s:2:"vi";}}